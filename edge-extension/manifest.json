{
  "manifest_version": 3,
  "name": "戴森球蓝图右键查看",
  "version": "0.1.0",
  "description": "右键网页里的蓝图文本，用蓝图工具打开。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": ["https://hckxv.github.io/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
